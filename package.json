{
  "name": "sile",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "test:contracts": "cd contracts && forge test",
    "spike": "tsx scripts/spike.ts",
    "gen:abi": "pnpm --filter @sile/abi gen",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@sile/abi": "workspace:^",
    "@sile/shared": "workspace:^",
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "viem": "^2.57.2",
    "vitest": "^5.0.3"
  }
}
