# Create a real .env with fresh funded test keys:  pnpm tsx scripts/init-env.ts
# Moderato testnet. Source: https://tempo.xyz/developers/docs/quickstart/connection-details
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
CHAIN_ID=42431
DEPLOYER_PRIVATE_KEY=0x...        # deploys PlanRegistry + SubscriptionLedger (admin)
OPERATOR_PRIVATE_KEY=0x...        # charger: markPaid/markPastDue/markCanceled + fee payer for every charge
OPERATOR_ADDRESS=0x...
MERCHANT_PRIVATE_KEY=0x...        # used by scripts only (the web uses your passkey/demo key)
MERCHANT_ADDRESS=0x...
KEYSTORE_SECRET=                  # >= 32 chars; encrypts access-key private keys at rest
WEBHOOK_SECRET=                   # >= 16 chars; HMAC for X-SiLe-Signature
# WEBHOOK_URL=https://example.com/sile-webhook
DEMO_PERIOD_SECONDS=60            # unset in production: enables demo plan period + /demo endpoints
DUNNING_SCHEDULE_SECONDS=10,30,60 # production default 3600,21600,86400
DATABASE_URL=./sile.sqlite
